# =============================================================================
# ContextOS — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=ContextOS
APP_ENV=development          # development | staging | production
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=contextos
POSTGRES_PASSWORD=contextos_secret
POSTGRES_DB=contextos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy URL (used inside Docker)
DATABASE_URL=postgresql+asyncpg://contextos:contextos_secret@postgres:5432/contextos
# For local development (outside Docker), change host to localhost:
# DATABASE_URL=postgresql+asyncpg://contextos:contextos_secret@localhost:5432/contextos

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextos_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Provider: openai | local | none
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# For local embeddings (Ollama):
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Repository Storage ───────────────────────────────────────────────────────
# Local path for cloned/cached repositories
REPO_CACHE_DIR=.repo_cache

# Maximum file size to index (bytes). Files larger than this are skipped.
MAX_FILE_SIZE_BYTES=524288    # 512 KB

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | text
