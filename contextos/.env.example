APP_NAME=ContextOS
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=replace-with-a-random-value-before-deploying
AUTH_ENABLED=true
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_TOKEN_TTL_SECONDS=28800
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_USER=contextos
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=contextos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contextos:replace-this-local-password@postgres:5432/contextos
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-this-local-password
NEO4J_DATABASE=neo4j
TYPESAFE_API_KEY=
JEV_ALLOW_SOURCE_UPLOAD=false
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDINGS_ALLOW_SOURCE_UPLOAD=false
EMBEDDING_BATCH_SIZE=64
MAX_EMBEDDINGS_PER_INDEX=1000
GRAPH_SYNC_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
REPO_CACHE_DIR=.repo_cache
REPOSITORY_ROOT=..
REPO_ALLOWED_ROOTS=/repos
MAX_FILE_SIZE_BYTES=524288
MAX_INDEXED_FILES=10000
MAX_INDEXED_TOTAL_BYTES=104857600
LOG_LEVEL=INFO
LOG_FORMAT=json
