APP_NAME=ContextOS
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=replace-with-a-random-value-before-deploying
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_USER=contextos
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=contextos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contextos:replace-this-local-password@postgres:5432/contextos
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-this-local-password
NEO4J_DATABASE=neo4j
TYPESAFE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
REPO_CACHE_DIR=.repo_cache
MAX_FILE_SIZE_BYTES=524288
LOG_LEVEL=INFO
LOG_FORMAT=json
